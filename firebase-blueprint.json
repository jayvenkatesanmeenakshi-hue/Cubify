{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in the StarVortex ecosystem.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "friendId": { "type": "string" },
        "bio": { "type": "string" },
        "aura": { "type": "number" },
        "points": { "type": "number" },
        "skill": { "type": "number" },
        "knowledge": { "type": "number" },
        "creation": { "type": "number" },
        "linkedApps": { "type": "array", "items": { "type": "string" } },
        "appsUsed": { "type": "array", "items": { "type": "string" } },
        "lastActive": { "type": "string", "format": "date-time" }
      }
    },
    "Activity": {
      "title": "Activity",
      "description": "A single activity log entry.",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "Chat": {
      "title": "Chat",
      "description": "A communication channel between users.",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "profiles": { "type": "object" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a chat.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "A request to establish a connection.",
      "type": "object",
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "fromProfile": { "type": "object" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Profiles of StarVortex users."
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": "Activity",
      "description": "Activity logs for a user."
    },
    "/friend_requests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Pending and past friend requests."
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat metadata and participant info."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual messages within a chat."
    }
  }
}
